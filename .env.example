# TEMPLATE ONLY. Never put a real key in a file you share on screen.
# Run python3 configure.py api to save the actual .env.api privately.
# This file uses JSON-quoted strings read by configure.load_config; do not source it.
HR_AGENT_ENGINE="openai"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="REPLACE_WITH_YOUR_API_KEY"
HR_AGENT_MODEL="REPLACE_WITH_YOUR_TOOL_CAPABLE_MODEL_ID"
# For Anthropic API: HR_AGENT_ENGINE="claude", ANTHROPIC_API_KEY="...", HR_AGENT_MODEL="..."
# For Ollama: OPENAI_BASE_URL="http://localhost:11434/v1/", OPENAI_API_KEY="local-demo", HR_AGENT_MODEL="qwen3:4b"
# For LM Studio: OPENAI_BASE_URL="http://localhost:1234/v1", OPENAI_API_KEY="local-demo", HR_AGENT_MODEL="YOUR_LOADED_MODEL_ID"
